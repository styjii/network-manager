DJANGO_SECRET_KEY=django-insecure-changez-moi
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF quand on accède par le réseau local
DJANGO_CSRF_TRUSTED_ORIGINS=
# Adresses des proxys de confiance (Nginx) dont l'en-tête X-Forwarded-For est lu
NM_TRUSTED_PROXIES=
